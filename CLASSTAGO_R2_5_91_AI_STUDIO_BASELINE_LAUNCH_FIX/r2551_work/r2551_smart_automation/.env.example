# Public frontend configuration (safe to expose to the client build)
VITE_SUPABASE_URL=https://lrjtfoosbubcfbthqbyu.supabase.co
VITE_SUPABASE_ANON_KEY=

# SERVER-ONLY secret. Add this in Google AI Studio: Settings > Secrets.
# Prefer a current Supabase Secret Key (format: sb_secret_...).
SUPABASE_SECRET_KEY=

# Optional legacy fallback only; do not set both unless you intentionally need it.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional SERVER-ONLY Cloudflare R2 large-Textbook storage.
# Do NOT prefix these with VITE_; they must never enter the browser bundle.
# When unset, EDUNIXO preserves the existing small-file Supabase Storage fallback.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=edunixo-study-materials

# Passkeys are free but domain-bound. Keep FALSE until the final custom domain / WebAuthn RP ID is locked.
VITE_EDUNIXO_PASSKEY_ENABLED=false

# Free standards-based Web Push (server-only VAPID keys). Generate with: npm run push:keys
EDUNIXO_VAPID_PUBLIC_KEY=
EDUNIXO_VAPID_PRIVATE_KEY=
EDUNIXO_VAPID_SUBJECT=

# Native Android Push (FCM HTTP v1) — optional/free transport.
# Keep these server-only. Do not expose them as VITE_* variables.
EDUNIXO_FIREBASE_PROJECT_ID=
EDUNIXO_FIREBASE_CLIENT_EMAIL=
EDUNIXO_FIREBASE_PRIVATE_KEY=

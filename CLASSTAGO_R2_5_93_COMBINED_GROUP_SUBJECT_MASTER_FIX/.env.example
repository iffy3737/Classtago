# Public frontend configuration (safe to expose to the client build)
VITE_SUPABASE_URL=https://lrjtfoosbubcfbthqbyu.supabase.co
VITE_SUPABASE_ANON_KEY=

# SERVER-ONLY secret. Add this in Google AI Studio: Settings > Secrets.
# Prefer a current Supabase Secret Key (format: sb_secret_...).
SUPABASE_SECRET_KEY=

# Optional legacy fallback only; do not set both unless you intentionally need it.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional SERVER-ONLY Cloudflare R2 large-Textbook storage.
# Do NOT prefix these with VITE_; they must never enter the browser bundle.
# When unset, EDUNIXO preserves the existing small-file Supabase Storage fallback.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=edunixo-study-materials

# Passkeys are free but domain-bound. Keep FALSE until the final custom domain / WebAuthn RP ID is locked.
VITE_EDUNIXO_PASSKEY_ENABLED=false

# Free standards-based Web Push (server-only VAPID keys). Generate with: npm run push:keys
EDUNIXO_VAPID_PUBLIC_KEY=
EDUNIXO_VAPID_PRIVATE_KEY=
EDUNIXO_VAPID_SUBJECT=

# Native Android Push (FCM HTTP v1) — optional/free transport.
# Keep these server-only. Do not expose them as VITE_* variables.
EDUNIXO_FIREBASE_PROJECT_ID=
EDUNIXO_FIREBASE_CLIENT_EMAIL=
EDUNIXO_FIREBASE_PRIVATE_KEY=

# R2.5.65 Multi-channel OTP security (SERVER-ONLY)
# Use a long random secret; never expose it as VITE_*.
EDUNIXO_OTP_PEPPER=

# WhatsApp OTP transport. EDUNIXO attempts WhatsApp independently of SIM SMS so
# an exhausted/offline SIM does not become a single point of failure.
# You may use one shared webhook or separate Platform/School endpoints.
OTP_WHATSAPP_WEBHOOK_URL=
OTP_WHATSAPP_WEBHOOK_TOKEN=
# PLATFORM_OTP_WHATSAPP_WEBHOOK_URL=
# PLATFORM_OTP_WHATSAPP_WEBHOOK_TOKEN=
# SCHOOL_OTP_WHATSAPP_WEBHOOK_URL=
# SCHOOL_OTP_WHATSAPP_WEBHOOK_TOKEN=

# Optional Email OTP backup via Resend. Leave unset to keep Email OTP disabled.
RESEND_API_KEY=
OTP_EMAIL_FROM=
# R2.5.82 Universal Gemini Live + natural voice (SERVER-ONLY)
# Existing GOOGLE_API_KEY or GEMINI_API_KEY powers the direct Gemini Live gateway and Gemini TTS.
# Permanent provider keys MUST stay server-side; never use a VITE_* prefix.
GOOGLE_API_KEY=
# Optional alias supported by existing deployments:
# GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
EDUNIXO_TTS_VOICE=Sulafat

# Free-first policy: paid/credit voice providers and the legacy Pipecat/Daily broker
# are OFF by default. Enable only after an explicit deployment decision.
EDUNIXO_ENABLE_PAID_VOICE_PROVIDER=false
EDUNIXO_ENABLE_LEGACY_PIPECAT=false

# Optional dormant custom voice provider. Ignored unless
# EDUNIXO_ENABLE_PAID_VOICE_PROVIDER=true.
FISH_AUDIO_API_KEY=
FISH_AUDIO_TTS_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_REFERENCE_ID=


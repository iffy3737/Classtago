{
	"appId": "com.classtago.app",
	"appName": "Classtago",
	"webDir": "mobile-dist",
	"server": {
		"url": "https://classtago.in/?edunixoApp=1",
		"cleartext": false,
		"androidScheme": "https",
		"allowNavigation": [
			"edunixo-production-final.onrender.com",
			"*.onrender.com",
			"*.supabase.co"
		]
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": false,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": false
		},
		"SystemBars": {
			"insetsHandling": "css"
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 800,
			"backgroundColor": "#F7F9FF",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP"
		},
		"StatusBar": {
			"overlaysWebView": false,
			"style": "DARK",
			"backgroundColor": "#F7F9FF"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		}
	}
}

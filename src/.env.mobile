# EDUNIXO native packaging mode. This file contains no secrets and is safe to commit.
VITE_EDUNIXO_MOBILE_APP=true
VITE_EDUNIXO_APP_RUNTIME=true
VITE_EDUNIXO_MOBILE_SCHOOL_NAME=Classtago

# Intentionally blank here. Put the live HTTPS Render origin in .env.mobile.local
# or your build environment before creating an installable APK/AAB.
VITE_EDUNIXO_API_BASE_URL=https://edunixo.onrender.com

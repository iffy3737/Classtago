{
  "name": "edunixo-mobile-premium",
  "private": true,
  "version": "0.2.50",
  "type": "module",
  "scripts": {
    "dev": "node tools/ensure-deps.mjs && node tools/dev.mjs",
    "build": "npm run build:full",
    "start": "node tools/start-production.mjs",
    "clean": "rm -rf dist mobile-dist server.js",
    "lint": "tsc --noEmit",
    "build:mobile": "node tools/ensure-deps.mjs && vite build --mode mobile",
    "preview:mobile": "vite preview --mode mobile",
    "dev:frontend": "node tools/ensure-deps.mjs && vite --host 0.0.0.0 --port 3000",
    "dev:api": "node tools/ensure-deps.mjs && tsx server.ts",
    "build:full": "vite build --mode app && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node tools/write-cloudrun-entry.mjs && node tools/verify-production-build.mjs",
    "build:app": "node tools/ensure-deps.mjs && vite build --mode app",
    "preview:app": "vite preview --mode app",
    "android:prepare": "node tools/ensure-deps.mjs && node tools/check-native-env.mjs && npm run build:mobile && npx cap sync android",
    "android:add": "node tools/ensure-deps.mjs && npx cap add android",
    "android:open": "node tools/ensure-deps.mjs && npx cap open android",
    "android:run": "node tools/ensure-deps.mjs && node tools/check-native-env.mjs && npm run build:mobile && npx cap sync android && npx cap run android",
    "android:doctor": "node tools/ensure-deps.mjs && npx cap doctor",
    "android:bootstrap": "node tools/ensure-deps.mjs && node tools/bootstrap-android.mjs",
    "android:project:doctor": "node tools/android-project-doctor.mjs",
    "android:apk:debug": "node tools/check-native-env.mjs && npm run android:prepare && cd android && ./gradlew assembleDebug",
    "android:aab": "node tools/check-native-env.mjs && npm run android:prepare && cd android && ./gradlew bundleRelease",
    "gcp-build": "npm run build:full",
    "start:direct": "node dist/server.js",
    "deploy:doctor": "node tools/deployment-doctor.mjs",
    "push:keys": "node tools/generate-vapid.mjs"
  },
  "dependencies": {
    "@google/genai": "2.10.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "qrcode.react": "^4.2.0",
    "tsx": "^4.21.0",
    "esbuild": "^0.25.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "react-is": "^19.0.0",
    "web-push": "^3.6.7",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "@capacitor/cli": "^8.0.0",
    "@types/web-push": "^3.6.4"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}

# Required inside Pipecat Cloud (or local Pipecat runner)
GOOGLE_API_KEY=your_existing_gemini_api_key

# Current low-latency native-audio default. Override without code changes if Google updates it.
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# Safe Pipecat/Gemini Live voice default; can be tuned after listening tests.
EDUNIXO_LIVE_VOICE=Aoede

# Required only for local Daily runner testing; Pipecat Cloud manages Daily transport itself.
# DAILY_API_KEY=your_daily_api_key
